import from "node:path" { default as path }
import from "node:fs" { promises as fs }

type CopilotCloudFileOps = any;

glob:priv MARKER: str = "Generated by OpenSpec for GitHub Copilot coding agent support.",
          KEY: str = "githubCopilot",
          SETUP_STEPS_BODY: str = """name: "Copilot Setup Steps"

# Runs automatically when changed (for validation) and can be triggered manually.
on:
  workflow_dispatch:
  push:
    paths:
      - .github/workflows/copilot-setup-steps.yml
  pull_request:
    paths:
      - .github/workflows/copilot-setup-steps.yml

jobs:
  # The job MUST be called `copilot-setup-steps` for Copilot coding agent to pick it up.
  copilot-setup-steps:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    permissions:
      contents: read

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Install OpenSpec CLI
        run: npm install -g @fission-ai/openspec

      - name: Verify OpenSpec CLI
        run: openspec --version
""",
          AGENT_HEAD: str = """---
name: OpenSpec
description: "Manages OpenSpec changes, specs, and workflows using the OpenSpec CLI. Use this agent for proposing changes, exploring ideas, validating artifacts, checking status, and archiving completed work."
tools:
  - "execute"
  - "read"
  - "search"
  - "edit"
---

""",
          AGENT_REST: str = """# OpenSpec Agent

You are a specialized agent for managing OpenSpec workflows. Before using the `openspec` CLI, run `openspec --version`. If it is unavailable, install it with `npm install -g @fission-ai/openspec`.

## What is OpenSpec?

OpenSpec is a structured change management system for codebases. It organizes work into **changes** with planning artifacts (proposals, specs, designs, tasks) that guide implementation.

## Available Commands

### Agent-Compatible CLI Commands (prefer `--json` for structured output)

| Command | Purpose |
|---------|---------|
| `openspec list [--json]` | List all changes and specs |
| `openspec show <item> [--json]` | View a specific change or spec |
| `openspec validate [--all] [--json]` | Validate changes and specs for issues |
| `openspec status [--change <name>] [--json]` | Show artifact progress for a change |
| `openspec instructions [artifact] [--change <name>] [--json]` | Get next-step instructions for a change |
| `openspec templates [--json]` | List available templates |
| `openspec schemas [--json]` | List available workflow schemas |
| `openspec archive <change> --json [--yes]` | Archive a completed change; use `--yes` only after confirming all tasks are complete |

### Interactive CLI Commands (use when prompted by the user)

| Command | Purpose |
|---------|---------|
| `openspec init` | Initialize OpenSpec in the project |
| `openspec update` | Update OpenSpec configuration and artifacts |
| `openspec view` | Interactive dashboard |
| `openspec config` | View or modify settings |

## Workflow

When asked to work with OpenSpec, follow this pattern:

1. **Find the change**: Run `openspec list --json` to see active changes.
2. **Check progress**: Run `openspec status --change <name> --json` for the selected change.
3. **Follow instructions**: Run `openspec instructions [artifact] --change <name> --json` for the next artifact.
4. **Validate before completing**: Run `openspec validate <name> --json`.

## Creating New Changes

When the user wants to propose a new change:

1. Run `openspec new change <name>`.
2. Run `openspec status --change <name> --json` to see the artifact sequence.
3. Use `openspec instructions [artifact] --change <name> --json` before creating each artifact.
4. Run `openspec validate <name> --json` when the artifacts are complete.

## Key Directories

- `openspec/` — Root OpenSpec directory
- `openspec/changes/` — Active changes with their artifacts
- `openspec/config.yaml` — Project configuration

## Best Practices

- Always use `--json` flag when you need to parse output programmatically
- Run `openspec validate` after creating or modifying artifacts
- Check `openspec status` before starting work to understand the current state
- When archiving, ensure all tasks are completed and validated first
""",
          WORKFLOW_NOW: str = """1. **Find the change**: Run `openspec list --json` to see active changes.
2. **Check progress**: Run `openspec status --change <name> --json` for the selected change.
3. **Follow instructions**: Run `openspec instructions [artifact] --change <name> --json` for the next artifact.
4. **Validate before completing**: Run `openspec validate <name> --json`.

## Creating New Changes

When the user wants to propose a new change:

1. Run `openspec new change <name>`.
2. Run `openspec status --change <name> --json` to see the artifact sequence.
3. Use `openspec instructions [artifact] --change <name> --json` before creating each artifact.
4. Run `openspec validate <name> --json` when the artifacts are complete.""",
          WORKFLOW_LEGACY: str = """1. **Check current state**: Run `openspec status --json` to understand what changes exist and their progress.
2. **Follow instructions**: Run `openspec instructions --json` to get context-aware next steps.
3. **Validate before completing**: Run `openspec validate --all --json` to ensure artifacts are correct.

## Creating New Changes

When the user wants to propose a new change:

1. Create the change directory under `openspec/changes/<change-name>/`
2. Generate the required planning artifacts based on the project's configured workflow schema
3. Run `openspec validate --json` to verify the artifacts are well-formed""",
          PREVIOUS: list[tuple[str, str]] = [
              (
                  "Before using the `openspec` CLI, run `openspec --version`. If it is unavailable, install it with `npm install -g @fission-ai/openspec`.",
                  "You have access to the `openspec` CLI through shell commands, pre-installed in the development environment via `copilot-setup-steps.yml`.",
              ),
              (
                  "| `openspec archive <change> --json [--yes]` | Archive a completed change; use `--yes` only after confirming all tasks are complete |",
                  "| `openspec archive <change>` | Archive a completed change |",
              ),
          ],
          LEGACY: list[tuple[str, str]] = [
              (WORKFLOW_NOW, WORKFLOW_LEGACY),
              ('  - "execute"\n  - "read"\n  - "search"\n  - "edit"', '  - "terminal"'),
              ("CLI through shell commands, pre-installed", "CLI which is pre-installed"),
              (
                  "| `openspec status [--change <name>] [--json]` | Show artifact progress for a change |",
                  "| `openspec status [--json]` | Show artifact progress for active changes |",
              ),
              (
                  "| `openspec instructions [artifact] [--change <name>] [--json]` |",
                  "| `openspec instructions [--json]` |",
              ),
              (
                  "- `openspec/config.yaml` — Project configuration",
                  "- `openspec/config.yaml` — Project configuration\n- `openspec/explorations/` — Exploration documents",
              ),
          ];

glob COPILOT_CLOUD_FILES: any = rec(
    setupSteps=path.join(".github", "workflows", "copilot-setup-steps.yml"),
    agent=path.join(".github", "agents", "openspec.agent.md"),
);

glob:priv ALTERNATE_AGENT: str = path.join(".github", "agents", "openspec.md"),
          DIRECT_OPS: any = rec(
              writeFile=lambda (filePath: str, content: str) -> any {
                  FileSystemUtils.writeFile(filePath, content)
              },
              removeFile=lambda (filePath: str) -> any { fs.unlink(filePath) },
          );

def includesGitHubCopilot(toolIds: any) -> bool {
    return "github-copilot" in toolIds;
}

def generateCopilotSetupSteps -> str {
    return f"# {MARKER}\n\n{SETUP_STEPS_BODY}";
}

def generateCopilotAgentFile -> str {
    return f"{AGENT_HEAD}<!-- {MARKER} -->\n\n{AGENT_REST}";
}

def:priv swap(content: str, pairs: list[tuple[str, str]]) -> str {
    for (old, new_) in pairs {
        if old not in content {
            raise new(globalThis.Error, f"Cannot build Copilot cloud file content: missing {old}");
        }
        at_ = content.index(old);
        content = content[:at_] + new_ + content[at_ + len(old):];
    }
    return content;
}

def:priv previousAgentBody(marked: bool = False) -> str {
    content = swap(AGENT_HEAD + AGENT_REST, PREVIOUS);
    return swap(content, [("\n# OpenSpec Agent", f"\n<!-- {MARKER} -->\n\n# OpenSpec Agent")])
        if marked
        else content;
}

def:priv currentContent(relPath: str) -> str {
    return generateCopilotSetupSteps()
        if relPath == COPILOT_CLOUD_FILES.setupSteps
        else generateCopilotAgentFile();
}

def:priv legacyContents(relPath: str) -> list[str] {
    if relPath == COPILOT_CLOUD_FILES.setupSteps {
        return [SETUP_STEPS_BODY];
    }
    return [
        AGENT_HEAD + AGENT_REST,
        previousAgentBody(),
        previousAgentBody(True),
        swap(previousAgentBody(), LEGACY),
    ];
}

def:priv isCurrent(relPath: str, content: str) -> bool {
    return content.replace("\r\n", "\n") == currentContent(relPath);
}

def:priv isLegacy(relPath: str, content: str) -> bool {
    return content.replace("\r\n", "\n") in legacyContents(relPath);
}

def:priv isManaged(relPath: str, content: str) -> bool {
    return isCurrent(relPath, content) or isLegacy(relPath, content);
}

async def:priv reconcile(fullPath: str, relPath: str, ops: any) -> bool {
    if await FileSystemUtils.fileExists(fullPath) {
        existing = await FileSystemUtils.readFile(fullPath);
        if isCurrent(relPath, existing) or not isLegacy(relPath, existing) {
            return False;
        }
    }
    await ops.writeFile(fullPath, currentContent(relPath));
    return True;
}

async def:priv statOrNone(filePath: str) -> any {
    try {
        return await fs.stat(filePath);
    } except Exception as e {
        err = js_error(e);
        if at(err, "code") != "ENOENT" {
            raise err;
        }
        return None;
    }
}

async def:priv assertCreatableFilePath(filePath: str) {
    candidate = path.dirname(filePath);
    while True {
        stats = await statOrNone(candidate);
        if stats is not None {
            if not stats.isDirectory() {
                raise new(globalThis.Error, f"Parent path is not a directory: {candidate}");
            }
            return;
        }
        parent = path.dirname(candidate);
        if parent == candidate {
            raise new(globalThis.Error, f"Cannot resolve a directory ancestor for: {filePath}");
        }
        candidate = parent;
    }
}

async def:priv assertMissingOrRegularFile(filePath: str) {
    stats = await statOrNone(filePath);
    if stats is not None and not stats.isFile() {
        raise new(globalThis.Error, f"Managed Copilot path is not a regular file: {filePath}");
    }
}

async def:priv classifyAgent(agentPath: str, alternatePath: str) -> str {
    if not await FileSystemUtils.fileExists(alternatePath) {
        return "reconcile";
    }
    if not await FileSystemUtils.fileExists(agentPath) {
        return "skip";
    }
    if isManaged(COPILOT_CLOUD_FILES.agent, await FileSystemUtils.readFile(agentPath)) {
        return "remove-managed";
    }
    raise new(
        globalThis.Error,
        f"Conflicting Copilot agent profiles: preserve either {ALTERNATE_AGENT} or {COPILOT_CLOUD_FILES.agent}",
    );
}

async def writeCopilotCloudFiles(projectPath: str, ops: any = None) -> any {
    ops = ops ?? DIRECT_OPS;
    (setupStepsPath, agentPath, alternatePath) = [
        FileSystemUtils.resolveProjectArtifactPath(projectPath, rel)
        for rel in [COPILOT_CLOUD_FILES.setupSteps, COPILOT_CLOUD_FILES.agent, ALTERNATE_AGENT]
    ];
    await assertCreatableFilePath(setupStepsPath);
    await assertCreatableFilePath(agentPath);
    for p in [setupStepsPath, agentPath, alternatePath] {
        await assertMissingOrRegularFile(p);
    }
    plan = await classifyAgent(agentPath, alternatePath);
    setupStepsWritten = await reconcile(setupStepsPath, COPILOT_CLOUD_FILES.setupSteps, ops);
    agentWritten = False;
    if plan == "reconcile" {
        agentWritten = await reconcile(agentPath, COPILOT_CLOUD_FILES.agent, ops);
    } elif plan == "remove-managed" {
        await ops.removeFile(agentPath);
    }
    return rec(setupStepsWritten=setupStepsWritten, agentWritten=agentWritten);
}

async def:priv cloudFiles(
    projectPath: str, managed: bool, first: bool = False, guard: bool = False
) -> list[any] {
    found: list[any] = [];
    for rel in globalThis.Object.values(COPILOT_CLOUD_FILES) {
        full = FileSystemUtils.resolveProjectArtifactPath(projectPath, rel);
        if guard {
            await assertMissingOrRegularFile(full);
        }
        if not await FileSystemUtils.fileExists(full) {
            continue;
        }
        content = await FileSystemUtils.readFile(full);
        if isManaged(rel, content) == managed {
            found.append((rel, full, content));
            if first {
                break;
            }
        }
    }
    return found;
}

async def removeCopilotCloudFiles(
    projectPath: str, ops: any = None, afterRemove: any = None
) -> int {
    ops = ops ?? DIRECT_OPS;
    managed = await cloudFiles(projectPath, True, guard=True);
    removed: list[any] = [];
    try {
        for (_, file, content) in managed {
            await ops.removeFile(file);
            removed.append((file, content));
        }
        if not missing(afterRemove) {
            await globalThis.Promise.resolve(afterRemove());
        }
    } except Exception as e {
        for (file, content) in removed {
            await ops.writeFile(file, content);
        }
        raise js_error(e);
    }
    return len(removed);
}

def readCopilotCloudOptIn(projectPath: str) -> any {
    value = at(readProjectConfig(projectPath), KEY, "cloudAgent");
    return value if kind(value) == "boolean" else None;
}

async def hasExistingManagedCloudFiles(projectPath: str) -> bool {
    return len(await cloudFiles(projectPath, True, first=True)) > 0;
}

async def isCopilotCloudEnabled(projectPath: str) -> bool {
    optIn = readCopilotCloudOptIn(projectPath);
    return optIn if kind(optIn) == "boolean" else await hasExistingManagedCloudFiles(projectPath);
}

async def persistCopilotCloudOptIn(projectPath: str, value: bool, required: bool = False) {
    yaml = need("yaml");
    configPath = resolveConfigFilePath(projectPath);
    if not configPath {
        if required {
            await FileSystemUtils.writeFile(
                FileSystemUtils.resolveProjectArtifactPath(projectPath, "openspec/config.yaml"),
                f"schema: spec-driven\n{KEY}:\n  cloudAgent: {globalThis.String(value)}\n",
            );
        }
        return;
    }
    FileSystemUtils.assertProjectArtifactPath(projectPath, configPath);
    parsed = yaml.parseDocument(await FileSystemUtils.readFile(configPath));
    rootIsMap = parsed.contents is JsNull or yaml.isMap(parsed.contents);
    if required and (len(parsed.errors) or not rootIsMap) {
        raise new(
            globalThis.Error,
            f"Cannot save the hosted Copilot setting in {configPath}. Fix the YAML and run update again.",
        );
    }
    if len(parsed.errors) {
        return;
    }
    doc = parsed if rootIsMap else new(yaml.Document);
    section = doc.getIn([KEY], True);
    if section is not None and not yaml.isMap(section) {
        doc.setIn([KEY], new(yaml.YAMLMap));
    }
    doc.setIn([KEY, "cloudAgent"], value);
    await FileSystemUtils.writeFile(configPath, doc.toString());
}

async def findUnmanagedCloudFiles(projectPath: str) -> list[any] {
    return [rel for (rel, _, _) in await cloudFiles(projectPath, False)];
}

async def listManagedCloudFiles(projectPath: str) -> list[any] {
    return [rel for (rel, _, _) in await cloudFiles(projectPath, True)];
}
